# ================= ÉCRAN 1 : accueil =================
class HomeScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.app = App.get_running_app()

        root = BoxLayout(orientation='vertical', padding=20, spacing=12)
        root.add_widget(Label(text='🎯 Quiz', font_size='36sp', bold=True,
                              size_hint_y=0.15))
        root.add_widget(Label(text='Choisis un thème', font_size='16sp',
                              size_hint_y=0.08, color=(0.7, 0.7, 0.8, 1)))

        self.themes_layout = GridLayout(cols=1, spacing=10, size_hint_y=0.77)
        root.add_widget(self.themes_layout)

        self.add_widget(root)
        self._peupler()

    def _peupler(self):
        self.themes_layout.clear_widgets()
        for theme in self.app.quizzes:
            best = self.app.best.get(theme, 0)
            b = Button(
                text=f'{theme}\nMeilleur : {best}/{self.app.nb_questions}',
                font_size='16sp',
                background_normal='',
                background_color=(0.2, 0.4, 0.7, 1),
            )
            b.bind(on_press=lambda inst, t=theme: self.lancer(t))
            self.themes_layout.add_widget(b)

    def on_enter(self):
        self._peupler()

    def lancer(self, theme):
        self.app.current_theme = theme
        self.manager.current = 'quiz'


# ================= ÉCRAN 2 : quiz =================
class QuizScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.app = App.get_running_app()

        root = BoxLayout(orientation='vertical', padding=12, spacing=10)

        header = BoxLayout(size_hint_y=0.07, spacing=6)
        self.lbl_progress = Label(text='1/5', size_hint_x=0.35, font_size='16sp',
                                  halign='left')
        self.lbl_progress.bind(size=lambda i, v: setattr(i, 'text_size', (v[0], v[1])))
        self.lbl_score = Label(text='Score : 0', size_hint_x=0.65, font_size='16sp',
                               halign='right')
        self.lbl_score.bind(size=lambda i, v: setattr(i, 'text_size', (v[0], v[1])))
        header.add_widget(self.lbl_progress)
        header.add_widget(self.lbl_score)
        root.add_widget(header)

        self.bar = ProgressBar(max=100, value=0, size_hint_y=0.04)
        root.add_widget(self.bar)

        self.lbl_question = Label(text='', font_size='20sp', bold=True,
                                  halign='center', valign='middle', size_hint_y=0.22)
        self.lbl_question.bind(size=lambda i, v: setattr(i, 'text_size', (v[0], v[1])))
        root.add_widget(self.lbl_question)

        self.answers_grid = GridLayout(cols=1, spacing=8, size_hint_y=0.55)
        self.answer_buttons = []
        for i in range(4):
            b = Button(text='', font_size='16sp', background_normal='',
                       background_color=(0.2, 0.3, 0.5, 1))
            b.bind(on_press=lambda inst, idx=i: self.repondre(idx))
            self.answer_buttons.append(b)
            self.answers_grid.add_widget(b)
        root.add_widget(self.answers_grid)

        self.btn_next = Button(text='Suivant →', size_hint_y=0.08,
                               font_size='18sp', background_normal='',
                               background_color=(0.2, 0.6, 0.3, 1),
                               opacity=0, disabled=True)
        self.btn_next.bind(on_press=self.suivant)
        root.add_widget(self.btn_next)

        self.add_widget(root)

    def on_pre_enter(self):
        theme = self.app.current_theme
        questions = list(self.app.quizzes[theme])
        random.shuffle(questions)
        self.questions = questions[:self.app.nb_questions]
        self.index = 0
        self.score = 0
        self.a_repondu = False
        self.afficher_question()

    def afficher_question(self):
        if self.index >= len(self.questions):
            self.terminer()
            return
        q = self.questions[self.index]
        self.lbl_progress.text = f'{self.index + 1}/{len(self.questions)}'
        self.lbl_score.text = f'Score : {self.score}'
        self.bar.value = (self.index / len(self.questions)) * 100
        self.lbl_question.text = q['question']
        for i, b in enumerate(self.answer_buttons):
            b.text = q['answers'][i]
            b.background_color = (0.2, 0.3, 0.5, 1)
        self.btn_next.opacity = 0
        self.btn_next.disabled = True
        self.a_repondu = False

    def repondre(self, idx):
        if self.a_repondu:
            return
        self.a_repondu = True
        correct = self.questions[self.index]['correct']

        for i, b in enumerate(self.answer_buttons):
            if i == correct:
                b.background_color = (0.2, 0.7, 0.3, 1)   # vert
            elif i == idx:
                b.background_color = (0.8, 0.2, 0.2, 1)   # rouge

        if idx == correct:
            self.score += 1
            self.lbl_score.text = f'Score : {self.score}'

        self.btn_next.opacity = 1
        self.btn_next.disabled = False

    def suivant(self, *args):
        self.index += 1
        self.afficher_question()

    def terminer(self):
        self.app.last_score = self.score
        self.app.last_total = len(self.questions)
        self.app.save_best()
        self.manager.current = 'result'


# ================= ÉCRAN 3 : résultat =================
class ResultScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.app = App.get_running_app()

        root = BoxLayout(orientation='vertical', padding=30, spacing=15)

        self.lbl = Label(text='', font_size='24sp',
                         halign='center', valign='middle')
        self.lbl.bind(size=lambda i, v: setattr(i, 'text_size', (v[0], v[1])))
        root.add_widget(self.lbl)

        btn_replay = Button(text='🔁 Rejouer', font_size='20sp',
                            size_hint_y=0.15, background_normal='',
                            background_color=(0.2, 0.6, 0.3, 1))
        btn_replay.bind(on_press=lambda *_: setattr(self.manager, 'current', 'quiz'))
        root.add_widget(btn_replay)

        btn_home = Button(text='🏠 Accueil', font_size='20sp',
                          size_hint_y=0.15, background_normal='',
                          background_color=(0.3, 0.3, 0.4, 1))
        btn_home.bind(on_press=lambda *_: setattr(self.manager, 'current', 'home'))
        root.add_widget(btn_home)

        self.add_widget(root)

    def on_pre_enter(self):
        score = self.app.last_score
        total = self.app.last_total
        pct = (score / total) * 100 if total else 0
        if pct >= 80:
            msg = "Excellent ! 🏆"
        elif pct >= 50:
            msg = "Pas mal 👍"
        else:
            msg = "Continue à t'entraîner 💪"
        self.lbl.text = f'{msg}\n\n{score} / {total}\n({pct:.0f}%)'


# ================= Application =================
class QuizApp(App):
    def build(self):
        Window.clearcolor = (0.08, 0.08, 0.12, 1)
        self.data_file = os.path.join(self.user_data_dir, 'quiz.json')
        self.nb_questions = 5
        self.quizzes = DEFAULT_QUIZZES
        self.best = {}
        self.current_theme = None
        self.last_score = 0
        self.last_total = 0
        self._load()

        sm = ScreenManager()
        sm.add_widget(HomeScreen(name='home'))
        sm.add_widget(QuizScreen(name='quiz'))
        sm.add_widget(ResultScreen(name='result'))
        return sm

    def _load(self):
        if not os.path.exists(self.data_file):
            self._save()
            return
        try:
            with open(self.data_file, 'r', encoding='utf-8') as f:
                data = json.load(f)
                if isinstance(data, dict) and 'best' in data:
                    self.best = data['best']
        except Exception:
            pass

    def _save(self):
        with open(self.data_file, 'w', encoding='utf-8') as f:
            json.dump({'best': self.best}, f, ensure_ascii=False, indent=2)

    def save_best(self):
        theme = self.current_theme
        if theme and self.last_score > self.best.get(theme, 0):
            self.best[theme] = self.last_score
            self._save()


if __name__ == '__main__':
    QuizApp().run()